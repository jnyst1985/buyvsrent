---
import BaseLayout from '../layouts/BaseLayout.astro';
import { HomePage } from '../components/calculator/HomePage';

const title = 'Rent vs. Buy Calculator: Free, No Paywall | RentVsBuyMath';
const description =
  'Should you buy a home or rent and invest the difference? A free calculator with symmetric opportunity cost, real tax rules, PMI and selling costs.';

const faq = [
  {
    q: 'Is it cheaper to rent or buy in 2026?',
    a: 'At mid-2026 mortgage rates (~6.5%), renting and investing the difference wins in most US markets at typical rent levels. In our national-typical scenario — a $420,000 home versus $2,100 rent with a 10-year stay — renting comes out about $67,000 ahead. Buying wins where rent is high relative to price, stays are long, or rates drop: the same scenario at a 4% mortgage flips to buying by $38,000.',
  },
  {
    q: 'How does this calculator decide which side wins?',
    a: 'It simulates both paths month by month for your whole stay: the buyer pays the mortgage, taxes, insurance, maintenance, and PMI and builds equity; the renter pays rent and invests the down payment plus every month’s cost difference. Whichever side is cheaper in a given month invests the surplus — both directions. At the end, both sides "cash out" (selling costs and taxes included) and we compare net worth.',
  },
  {
    q: 'What rent makes buying the better deal?',
    a: 'We compute a tipping-point rent for your exact inputs. In the default 2026 scenario it’s about $2,468/month on a $420,000 home — roughly 0.59% of the home’s value per month at 6.5% mortgage rates. If similar homes rent for more than that, buying wins; for less, renting wins. At 4% rates the tipping point drops to about 0.45% of home value.',
  },
  {
    q: 'Does it account for taxes?',
    a: 'Yes — with current US rules: the standard deduction versus itemizing (mortgage interest capped at $750,000 of loan, property tax capped by the $40,400 SALT limit), capital-gains tax on the investment portfolio, and the Section 121 home-sale exclusion ($250k single / $500k married). Outside the US, set the tax fields to zero and use it as a pre-tax comparison in any currency.',
  },
  {
    q: 'Why do most calculators favor buying?',
    a: 'Three common shortcuts: they compare a mortgage payment to rent while ignoring taxes, maintenance, and selling costs; they don’t invest the renter’s down payment; and they never credit the buyer’s surplus when renting is dearer, or the renter’s when owning is dearer. We model the opportunity cost symmetrically and document every formula on the methodology page.',
  },
  {
    q: 'Is this financial advice?',
    a: 'No. It’s an educational model driven entirely by your assumptions — small changes can flip the answer, which is why we show a sensitivity table with every result. Use it to understand the trade-off, then talk to a professional who knows your situation.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'RentVsBuyMath — Rent vs. Buy Calculator',
    url: 'https://rentvsbuymath.com',
    description,
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    featureList: [
      'Live verdict with tipping-point rent',
      'Symmetric opportunity-cost modeling',
      'US tax rules: standard vs itemized, SALT cap, Section 121',
      'PMI with automatic cancellation',
      'Sensitivity analysis on every result',
      'Works in 8 currencies',
      'Shareable scenario links',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];

// Only the four a reader would actually jump to. The rest of the page is read
// in sequence, so ten links would be noise.
const jumpLinks = [
  { href: '#rates', label: 'Rates' },
  { href: '#customize', label: 'Assumptions' },
  { href: '#audit', label: 'Audit' },
  { href: '#faq', label: 'FAQ' },
];
---

<BaseLayout {title} {description} path="/" {jsonLd} {jumpLinks}>
  {/*
    client:load, not client:only. The island server-renders at the default
    scenario first, so every figure, heading and FAQ answer is in the HTML a
    crawler receives, then hydrates for interaction. The previous build used
    client:only, which shipped an empty homepage to anything without JS - a bad
    trade on a page whose whole value is its content.
  */}
  <HomePage client:load />

  {/*
    Deliberately static Astro, outside the island: these links must be in the
    HTML a crawler receives no matter what hydration does, and they ship no JS.

    Why they exist at all. On 2026-07-29 `gsc inspect --sitemap` reported 12 of
    17 URLs indexed; the five "Discovered - currently not indexed" had NEVER
    been crawled, and four of them are the site's highest commercial-intent
    pages. They were not orphans - /guides links all four - but one link from a
    single low-authority hub was not enough to earn a crawl on a ten-day-old
    domain. The homepage is the most-crawled, highest-authority page here, so
    this is the cheapest crawl-priority signal available.

    White band: the FAQ band above is sage, so the colour change is the seam
    (audit check E). `.gc` is a bordered card, which is the kind that belongs on
    white - see DESIGN.md.
  */}
  <section class="band band-white" id="deeper">
    <div class="wrap">
      <h2>Go deeper</h2>
      <p class="h2sub">
        The calculator answers one scenario. These answer the questions it raises - the shortcuts
        worth knowing, and how this model differs from the ones you have already tried.
      </p>
      <div class="grid3">
        <a class="gc" href="/guides/is-it-better-to-rent-or-buy">
          <span class="cat">Guide</span>
          <h3>Is it better to rent or buy?</h3>
          <p>
            The whole argument in order: the five things that decide it, and why the mortgage
            payment is not the cost of owning.
          </p>
          <span class="meta"><span>The math</span></span>
        </a>
        <a class="gc" href="/free-nyt-style-rent-vs-buy-calculator">
          <span class="cat">Comparison</span>
          <h3>A free, NYT-style calculator</h3>
          <p>The methodology that made the Times calculator famous, free and fully documented.</p>
          <span class="meta"><span>Free</span><span>No paywall</span></span>
        </a>
        <a class="gc" href="/best-rent-vs-buy-calculators">
          <span class="cat">Comparison</span>
          <h3>The calculators compared</h3>
          <p>What each of the big rent-vs-buy calculators models, and where each one stops.</p>
          <span class="meta"><span>Review</span></span>
        </a>
        <a class="gc" href="/calculators/5-percent-rule">
          <span class="cat">Tool</span>
          <h3>The 5% rule</h3>
          <p>
            The 30-second screen for whether owning is cheaper this year - and the rate at which it
            becomes a 7% rule.
          </p>
          <span class="meta"><span>Calculator</span></span>
        </a>
        <a class="gc" href="/calculators/price-to-rent-ratio">
          <span class="cat">Tool</span>
          <h3>Price-to-rent ratio</h3>
          <p>Turn a price and a rent into one number you can compare across any two markets.</p>
          <span class="meta"><span>Calculator</span></span>
        </a>
        <a class="gc" href="/guides/when-does-buying-beat-renting">
          <span class="cat">Guide</span>
          <h3>When does buying beat renting?</h3>
          <p>
            The break-even year for real scenarios - and the three levers that pull it closer or
            push it out of reach.
          </p>
          <span class="meta"><span>The math</span></span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

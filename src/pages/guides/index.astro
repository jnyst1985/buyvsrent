---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CATEGORIES } from '../../content.config';
import { DEFAULT_INPUTS as D } from '../../lib/engine/defaults';
import { simulateCore, tippingPointRent } from '../../lib/engine/engine';
import { formatCurrency } from '../../lib/engine/format';
import { readingMinutes } from '../../lib/readingTime';

/**
 * A category pill row only earns its place once a category holds enough posts to
 * read as one. Four guides across four pills looks like a broken filter, not a
 * taxonomy - so the row stays hidden until something crosses this line.
 */
const CATEGORY_PILL_THRESHOLD = 3;

/**
 * Likewise the topic clusters: they are only worth rendering when there are
 * enough real guides to fill them. Linking to posts that do not exist yet would
 * ship dead internal links, which is worse than not having the block.
 */
const CLUSTER_THRESHOLD = 8;

const all = await getCollection('guides');
const guides = all.sort((a, b) => +b.data.pubDate - +a.data.pubDate);
const pillar = guides.find((g) => g.data.pillar) ?? guides[0];
const rest = guides.filter((g) => g !== pillar);

const counts = new Map<string, number>();
for (const g of guides) counts.set(g.data.category, (counts.get(g.data.category) ?? 0) + 1);
const showPills = [...counts.values()].some((n) => n >= CATEGORY_PILL_THRESHOLD);
const activeCategories = CATEGORIES.filter((c) => (counts.get(c) ?? 0) > 0);

const slugOf = (id: string) => id.replace(/\.md$/, '');
const fmt = (v: number) => formatCurrency(v, 'USD');
const round1k = (v: number) => '$' + (Math.round(v / 1000) * 1000).toLocaleString('en-US');
const shortDate = (d: Date) =>
  new Intl.DateTimeFormat('en-US', { month: 'short', year: 'numeric' }).format(d);

// Live figures for the pillar card, straight from the engine at build time.
const results = simulateCore(D);
const tip = tippingPointRent(D);
const rentWins = results.difference < 0;

const title = 'Rent vs. Buy Guides — The Math, Explained | RentVsBuyMath';
const description =
  "Guides on the rent-vs-buy decision: the 2026 math, break-even years, when renting wins, and what today's mortgage rates change. Every figure re-runnable.";
---

<BaseLayout {title} {description} path="/guides">
  <section class="phero">
    <div class="wrap">
      <h1>Guides</h1>
      <p class="lede">
        The rent-versus-buy question, one piece at a time. Every guide is worked with real numbers
        you can re-run in <a href="/">the calculator</a> - no rules of thumb, no "it depends".
      </p>
    </div>
  </section>

  {/* White, not sage. `.phero` IS sage, so a sage band here put two
      same-coloured bands back to back: 64px of hero padding plus 64px of band
      padding with no seam between them, which reads as a hole rather than as
      two sections meeting. Every other phero page follows the hero with white
      for exactly this reason. The ink feature card also lands harder on white. */}
  <section class="band band-white">
    <div class="wrap">
      {showPills && (
        <div class="cats">
          <a href="/guides" aria-current="page">All guides</a>
          {activeCategories.map((c) => <span>{c} ({counts.get(c)})</span>)}
        </div>
      )}

      {pillar && (
        <div class="feat">
          <div>
            <span class="tag">Start here</span>
            <h2>{pillar.data.title}</h2>
            <p>{pillar.data.description}</p>
            <a class="pill" href={`/guides/${slugOf(pillar.id)}`}>Read the guide</a>
          </div>
          <div class="fig">
            <div class="k">At {D.mortgageRatePct}% on a {fmt(D.homePrice)} home</div>
            <div class="v tabular">+{round1k(Math.abs(results.difference))}</div>
            <div class="k">
              {rentWins ? 'Renting and investing ends ahead' : 'Buying ends ahead'}.{' '}
              {tip && (
                <>
                  {rentWins ? 'Buying needs rent above' : 'Renting wins below'}{' '}
                  <b class="tabular">{fmt(tip)}</b>.
                </>
              )}
            </div>
          </div>
        </div>
      )}

      <div class="grid3">
        {rest.map((g) => (
          <a class="gc" href={`/guides/${slugOf(g.id)}`}>
            <span class="cat">{g.data.category}</span>
            <h3>{g.data.shortTitle ?? g.data.title}</h3>
            <p>{g.data.description}</p>
            <span class="meta">
              <span>{readingMinutes(g.body ?? '')} min read</span>
              <span>Updated {shortDate(g.data.updatedDate ?? g.data.pubDate)}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* Sage so the sequence keeps alternating (hero sage, guides white, this
      sage) - and the white cards inside read strongest against it. */}
  {guides.length < CLUSTER_THRESHOLD && (
    <section class="band band-sage">
      <div class="wrap">
        <h2>Also useful</h2>
        <p class="pb" style="margin-bottom:22px">
          Shorter answers and single-purpose tools, for when you do not need the whole argument.
        </p>
        <div class="grid3">
          <a class="gc" href="/calculators/5-percent-rule">
            <span class="cat">Tool</span>
            <h3>The 5% rule</h3>
            <p>The quick screen for whether owning is cheaper this year, and where it breaks.</p>
            <span class="meta"><span>Calculator</span></span>
          </a>
          <a class="gc" href="/calculators/price-to-rent-ratio">
            <span class="cat">Tool</span>
            <h3>Price-to-rent ratio</h3>
            <p>Turn a price and a rent into one number you can compare across markets.</p>
            <span class="meta"><span>Calculator</span></span>
          </a>
          <a class="gc" href="/faq">
            <span class="cat">Reference</span>
            <h3>Twenty questions, answered</h3>
            <p>The FAQ, each answer carrying the numbers behind it. Plus a full glossary.</p>
            <span class="meta"><span>FAQ</span><span>Glossary</span></span>
          </a>
          {/* These two had ZERO inbound internal links anywhere on the site -
              orphaned on the old design too, so not something the redesign
              caused. They sit in the sitemap with nothing pointing at them,
              which is a wasted asset for two pages that answer real queries.
              This block is where a real page that is not a guide belongs. */}
          <a class="gc" href="/free-nyt-style-rent-vs-buy-calculator">
            <span class="cat">Comparison</span>
            <h3>A free, NYT-style calculator</h3>
            <p>The methodology that made the Times calculator famous, free and documented.</p>
            <span class="meta"><span>Free</span><span>No paywall</span></span>
          </a>
          <a class="gc" href="/best-rent-vs-buy-calculators">
            <span class="cat">Comparison</span>
            <h3>The calculators compared</h3>
            <p>What each of the big rent-vs-buy calculators models, and where each one stops.</p>
            <span class="meta"><span>Review</span></span>
          </a>
        </div>
      </div>
    </section>
  )}
</BaseLayout>

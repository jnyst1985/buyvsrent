---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';

export interface Props {
  title: string;
  description: string;
  /** Path beginning with /, used for canonical + og:url. */
  path: string;
  /** Path to a 1200x630 image under /og/, defaults to the site-wide card. */
  ogImage?: string;
  /** Optional JSON-LD object(s) rendered in <head>. */
  jsonLd?: object | object[];
  /** Set for articles: enables og:type article + published/modified meta. */
  article?: { published: string; modified?: string };
}

const { title, description, path, ogImage = '/og/default.png', jsonLd, article } = Astro.props;
const site = 'https://rentvsbuymath.com';
const canonical = `${site}${path === '/' ? '' : path}`;
const ogImageUrl = `${site}${ogImage}`;
const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#2563eb" />

    <meta property="og:site_name" content="RentVsBuyMath" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {article && <meta property="article:published_time" content={article.published} />}
    {article?.modified && <meta property="article:modified_time" content={article.modified} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
    <Analytics />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-white focus:px-3 focus:py-2 focus:shadow"
    >
      Skip to content
    </a>

    <header class="border-b border-hairline">
      <nav
        class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3"
        aria-label="Main"
      >
        <a href="/" class="flex items-center gap-2 font-semibold tracking-tight text-ink">
          <svg width="22" height="22" viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <rect x="3" y="14" width="11" height="15" rx="1.5" fill="#2563eb" />
            <path d="M2 15 8.5 8 15 15" stroke="#2563eb" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
            <path d="M18 29V17m5 12V12m5 17V7" stroke="#059669" stroke-width="3" stroke-linecap="round" />
          </svg>
          RentVsBuyMath<span class="text-ink-muted">.com</span>
        </a>
        <div class="flex items-center gap-5 text-sm text-ink-secondary">
          <a href="/" class="hover:text-ink">Calculator</a>
          <a href="/methodology" class="hidden hover:text-ink sm:inline">Methodology</a>
          <a href="/guides" class="hover:text-ink">Guides</a>
          <a href="/faq" class="hidden hover:text-ink sm:inline">FAQ</a>
        </div>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="mt-16 border-t border-hairline">
      <div class="mx-auto max-w-5xl px-4 py-8 text-sm text-ink-muted">
        <div class="flex flex-wrap items-start justify-between gap-6">
          <div class="max-w-md">
            <p class="mb-2 font-medium text-ink-secondary">RentVsBuyMath.com</p>
            <p>
              A free, transparent rent-vs-buy calculator. Every formula is documented on the
              <a href="/methodology" class="underline underline-offset-2 hover:text-ink">methodology page</a>.
            </p>
          </div>
          <nav class="grid grid-cols-2 gap-x-10 gap-y-1.5" aria-label="Footer">
            <a href="/methodology" class="hover:text-ink">Methodology</a>
            <a href="/about" class="hover:text-ink">About</a>
            <a href="/guides" class="hover:text-ink">Guides</a>
            <a href="/contact" class="hover:text-ink">Contact</a>
            <a href="/faq" class="hover:text-ink">FAQ</a>
            <a href="/privacy" class="hover:text-ink">Privacy</a>
            <a href="/glossary" class="hover:text-ink">Glossary</a>
            <a href="/terms" class="hover:text-ink">Terms</a>
          </nav>
        </div>
        <p class="mt-8 border-t border-hairline pt-4 text-xs leading-relaxed">
          RentVsBuyMath.com provides educational estimates, not financial, tax, or investment advice.
          Results depend entirely on your assumptions. Consult a qualified professional before
          making housing or investment decisions. &copy; 2026 RentVsBuyMath.
        </p>
      </div>
    </footer>
  </body>
</html>

# Build-time analytics IDs — copy to .env and fill in. Astro inlines
# PUBLIC_* values at `npm run build`; nothing renders when a var is unset.

# Google Analytics 4
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google AdSense (set after approval)
PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# Microsoft Clarity
PUBLIC_CLARITY_PROJECT_ID=XXXXXXXXXX

---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title: string;
  description: string;
  path: string;
  heading: string;
  subheading?: string;
  updated?: string;
  ogImage?: string;
  jsonLd?: object | object[];
}

const { title, description, path, heading, subheading, updated, ogImage, jsonLd } = Astro.props;
---

<BaseLayout {title} {description} {path} {ogImage} {jsonLd}>
  <article class="mx-auto max-w-2xl px-4 py-10 sm:py-14">
    <header class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">{heading}</h1>
      {subheading && <p class="mt-3 text-lg text-ink-secondary">{subheading}</p>}
      {updated && <p class="mt-3 text-sm text-ink-muted">Last updated {updated}</p>}
    </header>
    <div class="prose-content">
      <slot />
    </div>
  </article>
</BaseLayout>

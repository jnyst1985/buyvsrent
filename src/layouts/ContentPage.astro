---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title: string;
  description: string;
  path: string;
  heading: string;
  subheading?: string;
  updated?: string;
  ogImage?: string;
  jsonLd?: object | object[];
}

const { title, description, path, heading, subheading, updated, ogImage, jsonLd } = Astro.props;
---

<BaseLayout {title} {description} {path} {ogImage} {jsonLd}>
  <section class="phero">
    <div class="wrap">
      <h1>{heading}</h1>
      {subheading && <p class="lede">{subheading}</p>}
      {updated && <p class="pb" style="font-size:14px;margin:0">Last updated {updated}</p>}
    </div>
  </section>

  <section class="band band-white">
    {/* .narrow, not .wrap: prose wants a measure, not the full 1160px container. */}
    <div class="narrow">
      <article class="prose-content">
        <slot />
      </article>
    </div>
  </section>
</BaseLayout>

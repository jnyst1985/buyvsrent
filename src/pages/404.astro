---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found | RentVsBuyMath"
  description="That page doesn't exist. Try the rent vs. buy calculator instead."
  path="/404"
>
  <section class="band band-white" style="text-align:center">
    <div class="narrow">
      <p style="font-size:13px;font-weight:700;letter-spacing:0.07em;text-transform:uppercase;color:var(--color-lose);margin:0">
        404
      </p>
      <h1
        class="display"
        style="font-size:clamp(28px,3.4vw,40px);margin:10px 0 0;max-width:none"
      >
        This page doesn't exist
      </h1>
      <p class="pb" style="margin:14px auto 24px;max-width:44ch">
        The math still does, though. Head back to the calculator to run your numbers.
      </p>
      <a class="pill" href="/">Open the calculator</a>
    </div>
  </section>
</BaseLayout>

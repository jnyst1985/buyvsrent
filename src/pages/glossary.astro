---
import BaseLayout from '../layouts/BaseLayout.astro';
import glossaryData from '../data/glossary.json';

const title = 'Rent vs. Buy Glossary: 26 Terms Defined | RentVsBuyMath';
const { description, terms } = glossaryData;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: 'Rent vs. Buy Glossary',
  url: 'https://rentvsbuymath.com/glossary',
  hasDefinedTerm: terms.map((t) => ({
    '@type': 'DefinedTerm',
    name: t.term,
    description: t.definition,
    url: `https://rentvsbuymath.com/glossary#${t.slug}`,
  })),
};

const sorted = [...terms].sort((a, b) => a.term.localeCompare(b.term));

// Grouped by initial so the alphabet strip has something to jump to. Built from
// the data rather than a hard-coded A-Z list, so a letter is only ever offered
// when there is a term under it.
const letters = [...new Set(sorted.map((t) => t.term[0].toUpperCase()))];
const byLetter = letters.map((l) => ({
  letter: l,
  items: sorted.filter((t) => t.term[0].toUpperCase() === l),
}));
const ALPHABET = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
---

<BaseLayout {title} {description} path="/glossary" jsonLd={jsonLd}>
  <section class="phero">
    <div class="wrap">
      <h1>Every term, defined plainly</h1>
      <p class="lede">
        The whole vocabulary of the rent-versus-buy decision, in the same language the calculator
        uses. Each definition stands on its own - quote it freely, with a link.
      </p>
      <div class="cats">
        <a href="/">Use the calculator</a>
        <span>{terms.length} terms</span>
        <span>Every one used by the model</span>
      </div>
    </div>
  </section>

  <section class="band band-white">
    <div class="wrap">
      <div class="msplit">
        <nav class="toc" aria-label="Jump to a letter">
          <div class="alpha">
            {
              ALPHABET.map((l) =>
                letters.includes(l) ? <a href={`#letter-${l}`}>{l}</a> : <span aria-hidden="true">{l}</span>
              )
            }
          </div>
        </nav>

        <div>
          {byLetter.map((group, gi) => (
            <section aria-labelledby={`letter-${group.letter}`}>
              <h2
                class="gletter"
                id={`letter-${group.letter}`}
                style={gi === 0 ? 'margin-top:0' : undefined}
              >
                {group.letter}
              </h2>
              <dl class="qlist">
                {group.items.map((t) => (
                  <div class="qitem" id={t.slug}>
                    <dt>
                      <a href={`#${t.slug}`} class="qanchor">
                        {t.term}
                        <span aria-hidden="true">#</span>
                      </a>
                    </dt>
                    <dd>{t.definition}</dd>
                  </div>
                ))}
              </dl>
            </section>
          ))}

          <p class="racenote" style="margin-top:38px">
            See the terms in action in <a href="/">the calculator</a>, or read how each one is
            applied on the <a href="/methodology">methodology page</a>.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

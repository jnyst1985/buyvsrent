---
/**
 * Third-party scripts, each rendered only when its PUBLIC_ env var is set in
 * Vercel (Settings → Environment Variables). Nothing loads without them.
 *   PUBLIC_GA_MEASUREMENT_ID   e.g. G-XXXXXXXXXX
 *   PUBLIC_ADSENSE_CLIENT_ID   e.g. ca-pub-XXXXXXXXXXXXXXXX
 *   PUBLIC_CLARITY_PROJECT_ID  e.g. abcdefghij
 */
const ga = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const adsense = import.meta.env.PUBLIC_ADSENSE_CLIENT_ID;
const clarity = import.meta.env.PUBLIC_CLARITY_PROJECT_ID;
---

{
  ga && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga}`} is:inline />
      <script
        is:inline
        set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${ga}');`}
      />
    </>
  )
}
{
  adsense && (
    <script
      async
      src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsense}`}
      crossorigin="anonymous"
      is:inline
    />
  )
}
{
  clarity && (
    <script
      is:inline
      set:html={`(function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window,document,"clarity","script","${clarity}");`}
    />
  )
}

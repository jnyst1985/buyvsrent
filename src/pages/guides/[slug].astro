---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { DEFAULT_INPUTS } from '../../lib/engine/defaults';
import { simulateCore, tippingPointRent } from '../../lib/engine/engine';
import { formatCurrency } from '../../lib/engine/format';
import { readingMinutes } from '../../lib/readingTime';
import { authorSchema, AUTHOR } from '../../lib/author';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry, all: guides },
  }));
}

const { entry, all } = Astro.props;
const { Content } = await render(entry);
const slug = entry.id.replace(/\.md$/, '');
const slugOf = (id: string) => id.replace(/\.md$/, '');

const published = entry.data.pubDate.toISOString().slice(0, 10);
const modifiedDate = entry.data.updatedDate ?? entry.data.pubDate;
const modified = modifiedDate.toISOString().slice(0, 10);
const longDate = (d: Date) =>
  new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric' }).format(d);
const minutes = readingMinutes(entry.body ?? '');

// Figures for the inline calculator, computed at build from the engine at the
// rate this article is arguing about. A guide about 7% quotes 7% numbers, and
// neither can drift from the calculator.
const rate = entry.data.calcRate ?? DEFAULT_INPUTS.mortgageRatePct;
const inputs = { ...DEFAULT_INPUTS, mortgageRatePct: rate };
const results = simulateCore(inputs);
const tip = tippingPointRent(inputs);
const tie = results.verdict === 'tie';
const rentWins = results.difference < 0;
const fmt = (v: number) => formatCurrency(v, inputs.currency);
const round1k = (v: number) => '$' + (Math.round(v / 1000) * 1000).toLocaleString('en-US');
const scenarioHref = `/?rent=${inputs.monthlyRent}&pp=${inputs.homePrice}&mr=${rate}&th=${inputs.timeHorizonYears}`;

// Two further guides, preferring the same category so the trail stays coherent.
const others = all.filter((g) => g.id !== entry.id);
const next = [
  ...others.filter((g) => g.data.category === entry.data.category),
  ...others.filter((g) => g.data.category !== entry.data.category),
].slice(0, 2);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: published,
  dateModified: modified,
  // A named person, not the organisation: rent-vs-buy is YMYL, and "who is
  // responsible for this" needs a human answer that resolves to /about.
  author: authorSchema,
  // Resolves to the site-wide Organization entity BaseLayout emits.
  publisher: { '@id': 'https://rentvsbuymath.com/#org' },
  articleSection: entry.data.category,
  mainEntityOfPage: `https://rentvsbuymath.com/guides/${slug}`,
};

// Mirrors the visible crumb (Guides › category › this page).
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://rentvsbuymath.com/' },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: 'https://rentvsbuymath.com/guides' },
    { '@type': 'ListItem', position: 3, name: entry.data.seoTitle ?? entry.data.title },
  ],
};
const jsonLdAll = [jsonLd, breadcrumbLd];
---

<BaseLayout
  title={`${entry.data.seoTitle ?? entry.data.title} | RentVsBuyMath`}
  description={entry.data.description}
  path={`/guides/${slug}`}
  jsonLd={jsonLdAll}
  article={{ published, modified }}
>
  <article class="art">
    <div class="narrow">
      <div class="crumb">
        <a href="/guides">Guides</a> &rsaquo; {entry.data.category}
      </div>
      <h1>{entry.data.title}</h1>
      <p class="lede" style="max-width:62ch">{entry.data.description}</p>

      <div class="artmeta">
        <a class="au" href="/about" rel="author">
          <span class="av" aria-hidden="true">{AUTHOR.initials}</span>
          Written by {AUTHOR.short}
        </a>
        <span>
          Updated <time datetime={modified}>{longDate(modifiedDate)}</time>
        </span>
        <span>{minutes} min read</span>
        <span>Every figure re-runnable</span>
      </div>

      {/* One spine: the scenario, then THE answer, then the single condition
          that would flip it, then the way out to the calculator. The previous
          version put a threshold rent and a net-worth gap side by side at the
          same size under same-styled labels, so the two pairs read as one
          four-item row and neither number said what kind of thing it was. */}
      <aside class="answerbox" aria-label="The answer for this scenario">
        <p class="ab-scn">
          At {rate.toFixed(2)}% on a {fmt(inputs.homePrice)} home, held{' '}
          {inputs.timeHorizonYears} years
        </p>

        <p class="ab-verdict">
          <span class="ab-who">
            {tie ? 'Too close to call' : rentWins ? 'Renting wins by' : 'Buying wins by'}
          </span>
          {!tie && <span class="ab-num">{round1k(Math.abs(results.difference))}</span>}
        </p>

        <p class="ab-basis">
          {tie
            ? 'The two paths land within a percent of each other - inside the margin of the assumptions.'
            : 'Measured on what you are worth at the end of the stay, not on what you paid.'}
        </p>

        <div class="ab-flip">
          {tip ? (
            <>
              <span class="ab-flip-k">{rentWins ? 'Buying wins above' : 'Buying stops winning below'}</span>
              <span class="ab-flip-v">
                {fmt(tip)}<span class="u">a month in rent</span>
              </span>
              <span class="ab-flip-x">
                That is {((tip / inputs.homePrice) * 100).toFixed(2)}% of the home price, per month.
              </span>
            </>
          ) : (
            <>
              <span class="ab-flip-k">No rent flips it</span>
              <span class="ab-flip-x">
                At these assumptions there is no monthly rent that changes the answer.
              </span>
            </>
          )}
        </div>

        <a class="pill" href={scenarioHref}>Run these numbers yourself</a>
      </aside>

      <Content />

      <div class="next">
        {next.map((g) => (
          <a class="gc" href={`/guides/${slugOf(g.id)}`}>
            <span class="cat">{g.data.category}</span>
            <h3>{g.data.shortTitle ?? g.data.title}</h3>
            <p>{g.data.description}</p>
            <span class="meta">
              <span>{readingMinutes(g.body ?? '')} min read</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </article>

  {/* Glossary popover. rehype-glossary wrapped the first occurrence of each
      term in the prose above as <a class="gloss">; this is the one popover
      they all share, and the script below is the whole runtime (~1KB). No JS
      = the terms are plain links to /glossary, which is the intended
      fallback, not a failure. */}
  <div class="gpop" id="gpop" role="tooltip" aria-hidden="true" data-place="above">
    <div class="gpop-arrow" aria-hidden="true"></div>
    <p class="gpop-t" id="gpop-t"></p>
    <p class="gpop-d" id="gpop-d"></p>
    <a class="gpop-more" id="gpop-more" href="/glossary">Full definition &rarr;</a>
  </div>

  <script>
    import { track } from '../../lib/track';

    const pop = document.getElementById('gpop')!;
    const tEl = document.getElementById('gpop-t')!;
    const dEl = document.getElementById('gpop-d')!;
    const mEl = document.getElementById('gpop-more') as HTMLAnchorElement;
    let current: HTMLElement | null = null;
    let openTimer: ReturnType<typeof setTimeout>, closeTimer: ReturnType<typeof setTimeout>;
    const fine = matchMedia('(pointer: fine)').matches;
    const seen = new Set<string>();

    const place = (el: HTMLElement) => {
      const r = el.getBoundingClientRect();
      pop.style.left = '0px';
      pop.style.top = '0px';
      const pw = pop.offsetWidth;
      const ph = pop.offsetHeight;
      const x = Math.min(Math.max(10, r.left + r.width / 2 - pw / 2), innerWidth - pw - 10);
      const above = r.top - ph - 12 > 8;
      pop.dataset.place = above ? 'above' : 'below';
      pop.style.left = `${x}px`;
      pop.style.top = `${above ? r.top - ph - 12 : r.bottom + 12}px`;
      const ar = pop.querySelector('.gpop-arrow') as HTMLElement;
      ar.style.left = `${Math.min(Math.max(14, r.left + r.width / 2 - x - 6), pw - 26)}px`;
    };

    const open = (el: HTMLElement) => {
      clearTimeout(closeTimer);
      if (current === el) return;
      current?.setAttribute('aria-expanded', 'false');
      current = el;
      const term = el.dataset.term ?? '';
      tEl.textContent = term;
      dEl.textContent = el.dataset.eli ?? '';
      mEl.href = el.getAttribute('href') ?? '/glossary';
      el.setAttribute('aria-expanded', 'true');
      el.setAttribute('aria-describedby', 'gpop');
      pop.classList.add('on');
      pop.setAttribute('aria-hidden', 'false');
      place(el);
      // Once per term per pageload - which terms readers need explained is
      // the reader-confusion sensor the Thursday review reads.
      if (!seen.has(term)) {
        seen.add(term);
        track('gloss_open', { term });
      }
    };

    const close = () => {
      if (!current) return;
      current.setAttribute('aria-expanded', 'false');
      current.removeAttribute('aria-describedby');
      current = null;
      pop.classList.remove('on');
      pop.setAttribute('aria-hidden', 'true');
    };

    document.querySelectorAll<HTMLElement>('.gloss').forEach((el) => {
      el.setAttribute('aria-expanded', 'false');
      if (fine) {
        el.addEventListener('mouseenter', () => {
          clearTimeout(openTimer);
          openTimer = setTimeout(() => open(el), 150);
        });
        el.addEventListener('mouseleave', () => {
          clearTimeout(openTimer);
          closeTimer = setTimeout(close, 250);
        });
      }
      el.addEventListener('click', (e) => {
        e.preventDefault();
        current === el ? close() : open(el);
      });
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          current === el ? close() : open(el);
        }
      });
    });
    pop.addEventListener('mouseenter', () => clearTimeout(closeTimer));
    pop.addEventListener('mouseleave', () => (closeTimer = setTimeout(close, 250)));
    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (current && !pop.contains(t) && !t.closest('.gloss')) close();
    });
    document.addEventListener('keydown', (e) => e.key === 'Escape' && close());
    addEventListener('scroll', () => current && place(current), { passive: true });
    addEventListener('resize', () => current && place(current));
  </script>
</BaseLayout>

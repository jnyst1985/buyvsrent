---
import BaseLayout from '../layouts/BaseLayout.astro';
import glossaryData from '../data/glossary.json';

const title = 'Rent vs. Buy Glossary: Every Term, Plainly Defined | RentVsBuyMath';
const { description, terms } = glossaryData;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: 'Rent vs. Buy Glossary',
  url: 'https://rentvsbuymath.com/glossary',
  hasDefinedTerm: terms.map((t) => ({
    '@type': 'DefinedTerm',
    name: t.term,
    description: t.definition,
    url: `https://rentvsbuymath.com/glossary#${t.slug}`,
  })),
};

const sorted = [...terms].sort((a, b) => a.term.localeCompare(b.term));
---

<BaseLayout {title} {description} path="/glossary" jsonLd={jsonLd}>
  <div class="mx-auto max-w-2xl px-4 py-10 sm:py-14">
    <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">Glossary</h1>
    <p class="mt-3 text-lg text-body">
      Every term in the rent-vs-buy decision, defined in plain language. Each definition stands on
      its own — quote freely with a link.
    </p>
    <dl class="mt-8 space-y-6">
      {
        sorted.map((t) => (
          <div id={t.slug} class="scroll-mt-20 border-b border-hairline pb-5">
            <dt class="font-semibold text-ink">
              <a href={`#${t.slug}`} class="hover:text-primary-deep">{t.term}</a>
            </dt>
            <dd class="mt-1.5 leading-relaxed text-body">{t.definition}</dd>
          </div>
        ))
      }
    </dl>
    <p class="mt-8 text-body">
      See the terms in action: <a href="/" class="text-primary-deep underline underline-offset-2">the calculator</a> ·
      <a href="/methodology" class="text-primary-deep underline underline-offset-2">full methodology</a>
    </p>
  </div>
</BaseLayout>

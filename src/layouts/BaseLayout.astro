---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import { TEST_COUNT } from '../lib/site';

export interface Props {
  title: string;
  description: string;
  /** Path beginning with /, used for canonical + og:url. */
  path: string;
  /** Path to a 1200x630 image under /og/, defaults to the site-wide card. */
  ogImage?: string;
  /** Optional JSON-LD object(s) rendered in <head>. */
  jsonLd?: object | object[];
  /** Set for articles: enables og:type article + published/modified meta. */
  article?: { published: string; modified?: string };
  /**
   * In-page anchors for the sticky nav, e.g. the homepage's Rates/Assumptions/
   * Audit/FAQ. When present the nav becomes a jump nav with scroll-spy and the
   * site links move to the right-hand group. When absent every page gets the
   * ordinary site nav instead - the mock is homepage-only and does not cover
   * this, but #rates does not exist on /methodology.
   */
  jumpLinks?: { href: string; label: string }[];
}

const {
  title,
  description,
  path,
  ogImage = '/og/default.png',
  jsonLd,
  article,
  jumpLinks,
} = Astro.props;

const site = 'https://rentvsbuymath.com';
const canonical = `${site}${path === '/' ? '' : path}`;
const ogImageUrl = `${site}${ogImage}`;
const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

const SITE_LINKS = [
  { href: '/', label: 'Calculator' },
  { href: '/methodology', label: 'Methodology' },
  { href: '/guides', label: 'Guides' },
  { href: '/faq', label: 'FAQ' },
];

// Terms is deliberately absent: Jon's call is Contact + Privacy only. The page
// still exists and stays in the sitemap, it just loses its footer link.
const FOOTER_LINKS = [
  { href: '/methodology', label: 'Methodology' },
  { href: '/about', label: 'About' },
  { href: '/guides', label: 'Guides' },
  { href: '/glossary', label: 'Glossary' },
  { href: '/faq', label: 'FAQ' },
  { href: '/contact', label: 'Contact' },
  { href: '/privacy', label: 'Privacy' },
  { href: '/terms', label: 'Terms' },
];

const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const year = 2026;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#ffffff" />

    <link rel="preload" href="/fonts/manrope-800.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:site_name" content="RentVsBuyMath" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {article && <meta property="article:published_time" content={article.published} />}
    {article?.modified && <meta property="article:modified_time" content={article.modified} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
    <Analytics />
  </head>
  <body>
    <a href="#main" class="skiplink">Skip to content</a>

    <nav class="sitenav" aria-label="Main" data-spy={jumpLinks ? 'on' : undefined}>
      <div class="in">
        <a href="/" class="word">RentVsBuyMath</a>

        {jumpLinks ? (
          <>
            <span class="jump" id="jump">
              {jumpLinks.map((l) => <a href={l.href}>{l.label}</a>)}
            </span>
            <span class="sp"></span>
            <span class="ext">
              <a href="/methodology">Methodology</a>
              <a href="/guides">Guides</a>
            </span>
          </>
        ) : (
          <>
            <span class="sp"></span>
            <span class="jump">
              {SITE_LINKS.map((l) => (
                <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
                  {l.label}
                </a>
              ))}
            </span>
          </>
        )}
      </div>
    </nav>

    <main id="main">
      <slot />
    </main>

    <footer class="sitefooter">
      <div class="wrap">
        <div class="brand">RentVsBuyMath</div>
        <nav class="fl" aria-label="Footer">
          {FOOTER_LINKS.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
        <p>
          A free, transparent rent-vs-buy calculator. Every formula is documented on the
          <a href="/methodology">methodology page</a>, and the code is open source with {TEST_COUNT}
          automated tests.
        </p>
        <p>
          This site provides educational estimates, not financial, tax or investment advice.
          Results depend entirely on your assumptions. Talk to a professional before making a
          decision this size.
        </p>
        <p>&copy; {year} RentVsBuyMath</p>
      </div>
    </footer>

    <script>
      const nav = document.querySelector('.sitenav');
      if (nav) {
        // Hairline only once the page has moved, so the nav sits flush at rest.
        const onScroll = () => nav.classList.toggle('stuck', window.scrollY > 4);
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });

        if (nav.getAttribute('data-spy') === 'on') {
          const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('#jump a'));
          const targets = links
            .map((a) => document.querySelector(a.getAttribute('href') || ''))
            .filter((el): el is Element => el instanceof Element);

          const spy = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                for (const a of links) {
                  // Remove rather than set "false": absent is cleaner for AT
                  // than a list of explicitly-not-current items.
                  if (a.getAttribute('href') === '#' + entry.target.id) {
                    a.setAttribute('aria-current', 'true');
                  } else {
                    a.removeAttribute('aria-current');
                  }
                }
              }
            },
            { rootMargin: '-64px 0px -60% 0px', threshold: 0 }
          );
          targets.forEach((el) => spy.observe(el));
        }
      }
    </script>
  </body>
</html>

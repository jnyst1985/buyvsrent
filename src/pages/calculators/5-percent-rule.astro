---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FivePercentRule from '../../components/calculator/FivePercentRule';
import { DEFAULT_INPUTS as D } from '../../lib/engine/defaults';
import { tippingPointRent } from '../../lib/engine/engine';

const entry = await getEntry('sections', 'five-percent-rule');
const Content = entry ? (await render(entry)).Content : null;

// The rate-adjusted equivalent of the rule, straight from the engine, so the
// page cannot claim a multiplier the calculator disagrees with.
const tip = tippingPointRent(D);
const tipPct = tip ? ((tip * 12) / D.homePrice * 100).toFixed(1) : null;

const title = '5% Rule Calculator: Rent vs. Buy in 10 Seconds | RentVsBuyMath';
const description =
  'Check the rent-vs-buy 5% rule instantly: if annual rent is under ~5% of the home price, renting is reasonable. Includes the 2026 rate-adjusted version of the rule.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: '5% Rule Rent vs. Buy Calculator',
  url: 'https://rentvsbuymath.com/calculators/5-percent-rule',
  description,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<BaseLayout {title} {description} path="/calculators/5-percent-rule" jsonLd={jsonLd}>
  <section class="phero">
    <div class="wrap">
      <h1>The 5% rule, in ten seconds</h1>
      <p class="lede">
        The famous shortcut: if a year of rent costs less than about 5% of the home's price, renting
        is financially reasonable. Check your numbers, then read why 5% is really 7% or more at 2026
        rates.
      </p>
      <div class="cats">
        <a href="/">Run the full model</a>
        <span>A screen, not a verdict</span>
        {tipPct && <span>Our model implies {tipPct}% at {D.mortgageRatePct}%</span>}
      </div>
    </div>
  </section>

  <section class="band band-white">
    <div class="wrap">
      <div class="narrow">
        {/* The tool is this page's module; everything under it is the standard
            prose column, identical to a guide's. */}
        <FivePercentRule client:visible />

        <article class="prose-content prose-after-module">
          {Content && <Content />}
        </article>

        <p class="racenote" style="margin-top:34px">
          Rules of thumb screen; models decide. <a href="/">Run the full month-by-month
          comparison</a>, or read <a href="/methodology">how it works</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
